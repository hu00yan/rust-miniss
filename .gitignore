# Rust build artifacts
/target/
/**/target/
/**/*.rs.bk

# Cargo registry and cache
.cargo/

# Cargo lock (library crate — don't track)
Cargo.lock

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Test/profiling artifacts
*.profraw

# Coverage reports
/target/coverage/
tarpaulin-report.html

# AI assistant files
.aider*
.claude/
**/.claude/
.scratch/
.serena/
*.data.old

# Debug tools (local only)
.gdbinit
lldbinit
valgrind.supp

# Temp dirs from tests/examples
/tmp/test.*
tempdir-*

# Metrics exporter temp
metrics_temp

# Valgrind/Perf outputs
vgcore.*
perf.data
perf*.data

# Bumpalo arenas (if leaked in tests)
arena-leak-*

# Slab pool temp (if testing)
slab-test.*

# Backup/broken files
*.backup
*.broken

# Benchmark criterion output
/criterion/

# Performance benchmark results (large binary/text artifacts)
bench/results/
