# Rust build artifacts
/target/
/**/*.rs.bk

# Cargo registry and cache (NEVER track - auto-generated, huge)
.cargo/

# Cargo lock file (optional, usually included for applications)
# Cargo.lock

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Test artifacts
*.profraw

# Benchmark results
/criterion/

# Coverage reports
/target/coverage/
tarpaulin-report.html
# AI Assistant files
.aider*
.claude/
**/.claude/
# Debug tools (local only)
.gdbinit
lldbinit
valgrind.supp

# Temp dirs from tests/examples
/tmp/test.*
tempdir-*

# Metrics exporter temp
metrics_temp

# Valgrind/Perf outputs
vgcore.*
perf.data

# Bumpalo arenas (if leaked in tests)
arena-leak-*

# Slab pool temp (if testing)
slab-test.*

